# Defaults for ESP32 target.
CONFIG_MAGNOLIA_ALLOC_SELFTESTS=n
CONFIG_MAGNOLIA_ALLOC_REGION_SIZE=65536
CONFIG_MAGNOLIA_ALLOC_MAX_REGIONS_PER_JOB=64
CONFIG_MAGNOLIA_ALLOC_MAX_HEAP_SIZE_PER_JOB=0
CONFIG_MAGNOLIA_ALLOC_JOB_HEAP_DEFAULT_PERCENT=50
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_ELF_LOADER_LOAD_PSRAM=y
CONFIG_ESP_EVENT_POST_FROM_IRAM_ISR=n
CONFIG_ESP_SPI_BUS_LOCK_ISR_FUNCS_IN_IRAM=n
CONFIG_ESP_INTR_IN_IRAM=n
CONFIG_ESP_PHY_IRAM_OPT=n
CONFIG_PM_SLEEP_FUNC_IN_IRAM=n
CONFIG_PM_SLP_IRAM_OPT=n
CONFIG_ESP_ROM_PRINT_IN_IRAM=n
CONFIG_ESP_SYSTEM_IN_IRAM=n
CONFIG_ESP_TIMER_IN_IRAM=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LOG_IN_IRAM=n
CONFIG_LIBC_MISC_IN_IRAM=n
CONFIG_LIBC_LOCKS_PLACE_IN_IRAM=n
CONFIG_SPI_FLASH_PLACE_FUNCTIONS_IN_IRAM=n
CONFIG_MAGNOLIA_LITTLEFS_BLOCK_COUNT=512
