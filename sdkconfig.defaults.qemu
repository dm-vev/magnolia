# QEMU does not emulate PSRAM; disable SPIRAM to avoid boot aborts.
# CONFIG_SPIRAM is not set
# Don't place ELF applets in PSRAM when running under QEMU.
# CONFIG_ELF_LOADER_LOAD_PSRAM is not set
# Match actual flash size used by QEMU.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Keep flash mode simple for QEMU.
# CONFIG_ESPTOOLPY_FLASH_MODE_AUTO_DETECT is not set
CONFIG_ESPTOOLPY_FLASHMODE_DOUT=y
CONFIG_ESPTOOLPY_FLASHMODE="dout"
CONFIG_MAGNOLIA_DEVFS_FB=y
CONFIG_MAGNOLIA_FB_BACKEND_QEMU=y
CONFIG_MAGNOLIA_FB_BACKEND_SPI_ST7786=n
CONFIG_MAGNOLIA_FB_WIDTH=320
CONFIG_MAGNOLIA_FB_HEIGHT=240
